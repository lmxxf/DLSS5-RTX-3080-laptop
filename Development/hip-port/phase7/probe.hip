using U=unsigned;
SM86_DEV U old_fp8(float x){U b=__builtin_bit_cast(U,x),s=(b>>24)&128,a=b&0x7fffffff;float magic;asm("add.rn.f32 %0,%1,0f46800000;":"=f"(magic):"f"(__builtin_bit_cast(float,a)));U sub=__builtin_bit_cast(U,magic)&255,r=a+0x7ffff+((a>>20)&1),norm=r>=0x43e00000?126:((r>>20)-960);return s|((a<0x3c800000)?sub:((a>=0x7f800000)?127:norm));}
SM86_DEV float old_med(float a,float b,float c){float r,hi;asm("min.f32 %0,%2,%3; max.f32 %1,%2,%3; max.f32 %0,%4,%0; min.f32 %0,%0,%1;":"=&f"(r),"=&f"(hi):"f"(b),"f"(c),"f"(a));return r;}
extern "C" __attribute__((global)) void primitives(const U* in,U* out,U n){U i=__builtin_amdgcn_workgroup_id_x()*32+sm86_lane_id();if(i>=n)return;U b=in[i];float x=__builtin_bit_cast(float,b);out[i*8]=old_fp8(x);out[i*8+1]=sm86_f32_to_e4m3_byte(x);out[i*8+2]=__builtin_bit_cast(U,old_med(x,-4.f,4.f));out[i*8+3]=__builtin_bit_cast(U,__builtin_amdgcn_fmed3f(x,-4.f,4.f));out[i*8+4]=__builtin_bit_cast(U,old_med(x,-448.f,448.f));out[i*8+5]=__builtin_bit_cast(U,__builtin_amdgcn_fmed3f(x,-448.f,448.f));out[i*8+6]=(b&0x80008000)|((b&0x7f007f00)>>1);out[i*8+7]=sm86_fp8_half_bits(b);}
extern "C" __attribute__((global)) void branchless_only(const float* in,U* out){U i=__builtin_amdgcn_workgroup_id_x()*32+sm86_lane_id();out[i]=sm86_f32_to_e4m3_byte(in[i]);}
extern "C" __attribute__((global)) void clamp_only(const float* in,float* out){U i=__builtin_amdgcn_workgroup_id_x()*32+sm86_lane_id();out[i]=__builtin_amdgcn_fmed3f(in[i],-448.f,448.f);}
